# ==============================================================================
# PLANTILLA DE VARIABLES DE ENTORNO PARA PRODUCCIÓN (GCP CLOUD RUN & CLOUD SQL)
# ==============================================================================
# IMPORTANTE: Nunca subas el archivo .env real con credenciales al repositorio.
# En producción, estas variables se inyectan a través de Google Cloud Secret Manager
# o GitHub Actions Secrets.

# ------------------------------------------------------------------------------
# 1. Configuración General del Servidor
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=8080
WEB_URL=https://sigre.cutonala.udg.mx

# ------------------------------------------------------------------------------
# 2. Base de Datos PostgreSQL 16 (Google Cloud SQL)
# ------------------------------------------------------------------------------
# Formato estándar TCP con IP privada / Cloud SQL Proxy:
DATABASE_URL="postgresql://sigre_user:TU_PASSWORD_SEGURO@10.x.x.x:5432/sigre_prod?schema=public&sslmode=prefer"
# O mediante socket Unix nativo de Cloud Run:
# DATABASE_URL="postgresql://sigre_user:TU_PASSWORD_SEGURO@/sigre_prod?host=/cloudsql/TU_PROYECTO_GCP:us-central1:sigre-postgres"

# ------------------------------------------------------------------------------
# 3. Caché y Bloqueo de Concurrencia (Redis 7 - Cloud Memorystore o Upstash)
# ------------------------------------------------------------------------------
# Si usas Google Cloud Memorystore (IP interna con Serverless VPC Connector):
REDIS_URL="redis://10.x.x.x:6379"
# O si usas un servicio gestionado como Upstash (con TLS):
# REDIS_URL="rediss://default:TU_TOKEN@tu-endpoint.upstash.io:6379"

# ------------------------------------------------------------------------------
# 4. Seguridad Criptográfica y Tokens de Sesión
# ------------------------------------------------------------------------------
# Genera llaves criptográficas seguras de al menos 64 caracteres:
# openssl rand -base64 48
JWT_ACCESS_SECRET="GENERA_UNA_LLAVE_ALEATORIA_DE_AL_MENOS_64_CARACTERES_AQUI"
JWT_REFRESH_SECRET="GENERA_OTRA_LLAVE_ALEATORIA_DE_AL_MENOS_64_CARACTERES_AQUI"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES="7d"

# ------------------------------------------------------------------------------
# 5. Autenticación Institucional Google OAuth (Cuentas @udg.mx / @alumnos.udg.mx)
# ------------------------------------------------------------------------------
# Obtenido desde Google Cloud Console > APIs & Services > Credentials:
GOOGLE_CLIENT_ID="1234567890-abcdefghijklmnopqrstuvwxyz.apps.googleusercontent.com"

# ------------------------------------------------------------------------------
# 6. Servicio de Correo Transaccional (SMTP Institucional o SendGrid / Resend)
# ------------------------------------------------------------------------------
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="notificaciones.sigre@cutonala.udg.mx"
SMTP_PASS="TU_CONTRASENA_DE_APLICACION"
SMTP_FROM='"SIGRE CUTonalá" <notificaciones.sigre@cutonala.udg.mx>'

# ------------------------------------------------------------------------------
# 7. Frontend (Variables inyectadas en tiempo de build con prefijo VITE_)
# ------------------------------------------------------------------------------
# URL pública del backend consumida por la SPA en el navegador:
VITE_API_BASE="https://api.sigre.cutonala.udg.mx/api"
