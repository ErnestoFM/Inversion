# ==============================================================================
# Proyecto Inversión — Variables de Entorno de Ejemplo (.env.example)
# ==============================================================================
# IMPORTANTE: Copia este archivo como '.env' para desarrollo local: cp .env.example .env

# --- Servidores y Puertos ---
PORT=8080
NODE_ENV=development
API_URL=http://localhost:8080
WEB_URL=http://localhost:3000

# --- Autenticación y Seguridad (JWT) ---
# Clave secreta para firmar Access Tokens (mínimo 32 caracteres)
JWT_ACCESS_SECRET=inversion_jwt_access_secret_key_32_chars_min
# Clave secreta para firmar Refresh Tokens (mínimo 32 caracteres)
JWT_REFRESH_SECRET=inversion_jwt_refresh_secret_key_32_chars_min
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# --- Base de Datos (PostgreSQL) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=inversion_db
DB_USER=postgres
DB_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/inversion_db?schema=public

# --- Redis (Caché, Rate Limiting y Sesiones) ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# --- Servicios Externos y APIs (Opcionales) ---
# GOOGLE_CLIENT_ID=your_google_oauth_client_id
# RECAPTCHA_SITE_KEY=your_recaptcha_site_key
# RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key
